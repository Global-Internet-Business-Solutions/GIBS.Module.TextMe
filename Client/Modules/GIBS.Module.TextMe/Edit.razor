@using System.Net.Http.Json
@using GIBS.Module.TextMe.Models
@namespace GIBS.Module.TextMe
@inherits ModuleBase
@inject HttpClient Http

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Messages</h5>
        <button class="btn btn-secondary btn-sm" @onclick="LoadMessages">Refresh</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert alert-info py-1 px-2">@_status</div>
    }

    @if (_isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (_messages.Count == 0)
    {
        <p>No messages found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Direction</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Status</th>
                        <th>Message</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _messages.OrderByDescending(x => x.CreatedOn))
                    {
                        <tr>
                            <td>@item.MessageId</td>
                            <td>@item.Direction</td>
                            <td>@item.SenderNumber</td>
                            <td>@item.RecipientNumber</td>
                            <td>@item.Status</td>
                            <td>@item.Body</td>
                            <td>@item.CreatedOn.ToLocalTime()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;
    public override string Actions => "Edit";
    public override string Title => "Manage Text Messages";

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.TextMe/Module.css")
    };

    private bool _isLoading;
    private string _status;
    private List<ChatMessageDto> _messages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        _isLoading = true;
        _status = string.Empty;

        try
        {
            _messages = await Http.GetFromJsonAsync<List<ChatMessageDto>>($"api/TextMe/messages/{ModuleState.ModuleId}") ?? new List<ChatMessageDto>();
        }
        catch (Exception ex)
        {
            _messages = new List<ChatMessageDto>();
            _status = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
