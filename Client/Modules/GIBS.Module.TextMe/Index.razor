@using System.Net.Http.Json
@using GIBS.Module.TextMe.Models
@implements IDisposable
@namespace GIBS.Module.TextMe
@inherits ModuleBase
@inject HttpClient Http

<div class="text-end">
<ActionLink Action="Edit" Security="SecurityAccessLevel.Edit" Style="margin-right:10px;" Class="btn btn-secondary mb-2" IconName="menu" Text="Messages" ResourceKey="Messages" />
</div>
<div class="gibs-chat-widget">
    @if (_isOpen)
    {
        <div class="gibs-chat-panel">
            <div class="gibs-chat-header">
                <span>Text Us</span>
                <button class="btn btn-sm btn-light" @onclick="ToggleWidget">×</button>
            </div>
            <div class="gibs-chat-body">
                <div class="mb-2">
                    <input class="form-control mb-2" placeholder="Your name" @bind="_name" />
                    <input class="form-control mb-2" placeholder="Phone (optional)" @bind="_visitorPhone" />
                    <textarea class="form-control" rows="3" placeholder="Type your message" @bind="_message"></textarea>
                    <button class="btn btn-primary mt-2 w-100" @onclick="SendMessage" disabled="@_isSending">@(_isSending ? "Sending..." : "Send")</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <div class="alert alert-info py-1 px-2">@_status</div>
                }

                <div class="gibs-chat-thread">
                    @foreach (var item in _messages)
                    {
                        <div class="gibs-chat-line @(item.Direction == "Outbound" ? "outbound" : "inbound")">
                            <div>@item.Body</div>
                            <small>@item.CreatedOn.ToLocalTime().ToShortTimeString()</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <button class="gibs-chat-bubble" @onclick="ToggleWidget" title="Open chat">
        💬
        @if (_unreadCount > 0)
        {
            <span class="gibs-chat-badge">@_unreadCount</span>
        }
    </button>
</div>

@code {
    public override string RenderMode => RenderModes.Interactive;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.TextMe/Module.css?v=2"),
        new Script("_content/GIBS.Module.TextMe/Module.js?v=1.1")
    };

    private bool _isOpen;
    private bool _isSending;
    private string _name;
    private string _visitorPhone;
    private string _message;
    private string _status;
    private int _unreadCount;
    private DateTime? _lastMessageOn;
    private string _conversationId;
    private System.Threading.Timer _pollTimer;
    private readonly List<ChatMessageDto> _messages = new();

    protected override async Task OnInitializedAsync()
    {
        await EnsureConversationIdAsync();
        await RefreshMessagesAsync();
        _pollTimer = new System.Threading.Timer(async _ => await PollAsync(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void ToggleWidget()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _unreadCount = 0;
        }
    }
    
    private async Task SendMessage()
    {
        if (_isSending || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_message))
        {
            _status = "Name and message are required.";
            return;
        }

        _isSending = true;
        _status = string.Empty;

        try
        {
            if (string.IsNullOrWhiteSpace(_conversationId))
            {
                await EnsureConversationIdAsync();
            }

            var request = new ChatSendRequest { Name = _name, VisitorPhoneNumber = _visitorPhone, Message = _message, ConversationId = _conversationId };
            var response = await Http.PostAsJsonAsync($"api/TextMe/send/{ModuleState.ModuleId}", request);

            if (response.IsSuccessStatusCode)
            {
                _message = string.Empty;
                _status = "Message sent. Our team will reply soon.";
                await RefreshMessagesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _status = string.IsNullOrWhiteSpace(error)
                    ? $"Unable to send message right now. HTTP {(int)response.StatusCode}."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _status = $"Unable to send message right now. {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_conversationId))
            {
                return;
            }

            var queryParts = new List<string> { $"conversationId={Uri.EscapeDataString(_conversationId)}" };
            if (_lastMessageOn.HasValue)
            {
                queryParts.Add($"sinceUtc={Uri.EscapeDataString(_lastMessageOn.Value.ToUniversalTime().ToString("O"))}");
            }

            var items = await Http.GetFromJsonAsync<List<ChatMessageDto>>($"api/TextMe/messages/{ModuleState.ModuleId}?{string.Join("&", queryParts)}") ?? new List<ChatMessageDto>();
            if (items.Count > 0)
            {
                foreach (var item in items)
                {
                    if (_messages.All(x => x.MessageId != item.MessageId))
                    {
                        _messages.Add(item);
                    }
                }

                _lastMessageOn = _messages.Max(item => item.CreatedOn);
                if (!_isOpen)
                {
                    _unreadCount += items.Count;
                }

                if (items.Any(item => item.Direction == "Inbound"))
                {
                    await JSRuntime.InvokeVoidAsync("GIBS.TextMe.playTone");
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
        }
    }

    private async Task RefreshMessagesAsync()
    {
        if (string.IsNullOrWhiteSpace(_conversationId))
        {
            _messages.Clear();
            return;
        }

        var items = await Http.GetFromJsonAsync<List<ChatMessageDto>>($"api/TextMe/messages/{ModuleState.ModuleId}?conversationId={Uri.EscapeDataString(_conversationId)}") ?? new List<ChatMessageDto>();
        _messages.Clear();
        _messages.AddRange(items);
        if (_messages.Count > 0)
        {
            _lastMessageOn = _messages.Max(item => item.CreatedOn);
        }
    }

    private async Task EnsureConversationIdAsync()
    {
        var storageKey = $"gibs-textme-conversation-{ModuleState.ModuleId}";
        _conversationId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", storageKey);
        if (string.IsNullOrWhiteSpace(_conversationId))
        {
            _conversationId = Guid.NewGuid().ToString("N");
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", storageKey, _conversationId);
        }
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
